# Copy the blocks you need into the matching .env.<env> file and fill in real values.
# .env.<env> files are gitignored; this .env.example (placeholders only) is committed.
#
# Root .env holds ONLY the selector:
TEST_ENV=QAN

# ── .env.qan ────────────────────────────────────────────────────────────────
QAN_URL=
QAN_USERNAME=
QAN_PASSWORD=

QAN_DB_NAME=
QAN_DB_HOST=
QAN_DB_USER=
QAN_DB_PASSWORD=

# ── .env.integration ────────────────────────────────────────────────────────
INTEGRATION_URL=
INTEGRATION_USERNAME=
INTEGRATION_PASSWORD=

INTEGRATION_DB_NAME=
INTEGRATION_DB_HOST=
INTEGRATION_DB_USER=
INTEGRATION_DB_PASSWORD=

# ── .env.stage ──────────────────────────────────────────────────────────────
STAGE_URL=
STAGE_USERNAME=
STAGE_PASSWORD=

STAGE_DB_NAME=
STAGE_DB_HOST=
STAGE_DB_USER=
STAGE_DB_PASSWORD=

# ── .env.prod ───────────────────────────────────────────────────────────────
PROD_URL=
PROD_USERNAME=
PROD_PASSWORD=

PROD_DB_NAME=
PROD_DB_HOST=
PROD_DB_USER=
PROD_DB_PASSWORD=

# ── .env.jira ─────────────────────────────────────────────────────────────────
# Jira / Xray Cloud integration (test-case import + results reporting). Gitignored.
JIRA_BASE_URL=https://<your-site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=NUI
JIRA_PROJECT_ID=10206

# Xray Cloud API key (Jira -> Apps -> Xray -> API Keys). Separate from the Jira token.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# STE summary format is: "<PROJECT> | <Feature> | <ENV> | <YYYY-MM-DD>"  (date only, no time;
# ENV = active TEST_ENV, e.g. QAN/PROD, so the team sees which environment the run hit).
# Same-day re-runs on the same env reuse & override that STE; a new env or new day => new STE.
#
# Optional reporting overrides:
#   XRAY_COMPONENT            Jira Component for new STEs (NUI makes it mandatory; default "UI")
#   XRAY_STE_SUMMARY          force the STE summary verbatim (only honored for single-feature runs)
#   XRAY_TEST_EXECUTION_KEY   force results into one explicit existing STE (e.g. NUI-7900)
#   XRAY_ATTACH_EVIDENCE      "false" to disable screenshot/video evidence upload (default on)
#   XRAY_MAX_EVIDENCE_MB      per-file evidence size cap in MB (default 10; raise for large videos)
# XRAY_COMPONENT=UI
# XRAY_STE_SUMMARY=
# XRAY_TEST_EXECUTION_KEY=
# XRAY_ATTACH_EVIDENCE=true
# XRAY_MAX_EVIDENCE_MB=10

# ── Results reporting toggle (set at RUN time, not stored here normally) ───────
# XRAY_REPORT=true enables the Xray reporter. Leave unset for offline local runs.
#   PowerShell:  $env:XRAY_REPORT='true'; npx playwright test tests/billing-transactions.spec.js
