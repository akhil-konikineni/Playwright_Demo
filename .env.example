# .env.example — copy to .env in the project root and fill in real values.
# .env must never be committed to git (it is already gitignored).

# ENVIRONMENT=stage
URL=https://portal.qan.aws.eseye.io/login

# Login Credentials
USERNAME=<qan-username>
PASSWORD=<qan-password>

#------ INTEGRATION DB Credentials --------#
# DB_HOST=<integration-db-host>
# DB_USER=<integration-db-user>
# DB_PASSWORD=<integration-db-password>
# DB_NAME=<integration-db-name>

#------ QAN DB Credentials --------#
QA_DB_HOST=<qan-db-host>
QA_DB_USER=<qan-db-user>
QA_DB_PASSWORD=<qan-db-password>
QA_DB_NAME=<qan-db-name>
